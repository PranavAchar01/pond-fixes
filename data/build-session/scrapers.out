# 0.1s
{"scrapers":[{"key":"app_store_reviews","platform":"app_store","title":"App Store reviews","finds":"The newest customer reviews of an iPhone or iPad app on the Apple App Store, with star rating, title, text and date.","hint":"Pass the app's numeric id, the digits after id in its App Store link. Add a two-letter country to read that country's storefront; the default is the United States. Each run returns the newest page of reviews.","entity_type":"post","fields":[{"name":"app_id","description":"The app's numeric App Store id, such as 570060128: the digits after id in its App Store link.","example":"570060128","kind":"string","max_chars":20},{"name":"country","description":"Two-letter country of the App Store to read, such as gb. Leave out for the United States.","example":"gb","kind":"string","max_chars":2}],"required_any_of":[["app_id"]]},{"key":"facebook_ads","platform":"facebook","title":"Facebook ads","finds":"Ads currently running on Facebook and Instagram, found by search phrase or by the advertiser's Facebook page, with the ad text, advertiser, start date, platforms and landing page.","hint":"Give one to five search phrases as queries, such as \"dental implants\", to find ads that mention them, or one to five https://www.facebook.com/\u003cname\u003e page URLs as page_urls to see the ads those businesses run; use one or the other, not both. country is a two-letter code (US by default; GB for the United Kingdom) and keeps only ads shown in that country. Only ads that are running now are returned, and each record links to the ad in Meta's Ad Library. A daily run of a page watch asks only for the last day; a search watch returns the running ads again each day.","entity_type":"post","fields":[{"name":"queries","description":"Words or phrases to search ads for, such as \"dental implants\", 1 to 5. Use either queries or page_urls.","example":"dental implants","kind":"string_list","max_items":5,"max_chars":200},{"name":"page_urls","description":"Public Facebook page URLs of the advertisers whose ads to collect, 1 to 5. Use either queries or page_urls.","example":"https://www.facebook.com/examplebakery","kind":"url_list","max_items":5,"max_chars":2000},{"name":"country","description":"Two-letter code of the country the ads are shown in, such as US, CA or GB. Defaults to US.","example":"US","kind":"string","max_chars":20}],"required_any_of":[["queries"],["page_urls"]]},{"key":"facebook_groups","platform":"facebook","title":"Facebook groups","finds":"Recent posts from public Facebook groups, with the author, text, reactions, comments and shares.","hint":"Only public groups work. Find groups with a web search such as \"\u003ccity\u003e moms group facebook\", then pass their https://www.facebook.com/groups/... URLs.","entity_type":"post","fields":[{"name":"group_urls","description":"Public Facebook group URLs, 1 to 10. Private groups return nothing.","example":"https://www.facebook.com/groups/123456789012345","kind":"url_list","max_items":10,"max_chars":2000}],"required_any_of":[["group_urls"]]},{"key":"facebook_pages","platform":"facebook","title":"Facebook business pages","finds":"Public details of Facebook business pages, with name, category, address, phone, email, website, follower count and description.","hint":"Pass the https://www.facebook.com/\u003cname\u003e URLs of the pages to look up; find them with a web search such as \"\u003cbusiness\u003e \u003ccity\u003e facebook\". Profile and group URLs are not accepted. Personal profiles are not supported; give business page URLs only. Phone and email are the business's own published contact details, and many pages list none. Each page is one record; its posts are not included.","entity_type":"company","fields":[{"name":"page_urls","description":"Public Facebook page URLs, 1 to 10. Personal profiles and groups are not accepted.","example":"https://www.facebook.com/examplebakery","kind":"url_list","max_items":10,"max_chars":2000}],"required_any_of":[["page_urls"]]},{"key":"google_ads","platform":"google_ads","title":"Google ads","finds":"Ads a company runs on Google, from the Google Ads Transparency Center, with advertiser, format, a link to the ad image or video, and the dates they were first and last seen.","hint":"Pass the company's website domain, such as tesla.com. Add media_type text, image or video to keep one format. Each run returns the first page of ads.","entity_type":"post","fields":[{"name":"domain","description":"The advertiser's website domain, such as tesla.com. A web address is reduced to its domain.","example":"tesla.com","kind":"string","max_chars":253},{"name":"media_type","description":"Only ads of this format: text, image or video. Leave out for all formats.","example":"video","kind":"string","max_chars":5}],"required_any_of":[["domain"]]},{"key":"google_maps_places","platform":"google_maps","title":"Google Maps businesses","finds":"Businesses listed on Google Maps for a search and a place, with name, category, address, phone, website, business email, rating and opening hours.","hint":"Give one to five business types (what you would type into the Google Maps search box) and one location, such as a city. Each search returns up to 20 places. Emails are general business inboxes taken from the business website, when it lists one. Use min_rating and with_website to narrow the list.","entity_type":"company","fields":[{"name":"queries","description":"What to look for, as you would type it into Google Maps, such as \"dental clinic\". 1 to 5, used together with location.","example":"dental clinic","kind":"string_list","max_items":5,"max_chars":200},{"name":"location","description":"City, region or country to search in, such as \"Austin, TX\". Use together with queries.","example":"Austin, TX","kind":"string","max_chars":100},{"name":"min_rating","description":"Only places rated at least this many stars: 1, 2, 3, 4 or 4.5. Leave out for all places.","example":"4","kind":"string","max_chars":20},{"name":"with_website","description":"\"yes\" for only places that list a website, \"no\" for only places that do not. Leave out for both.","example":"yes","kind":"string","max_chars":20}],"required_any_of":[["queries","location"]]},{"key":"google_maps_reviews","platform":"google_maps","title":"Google Maps reviews","finds":"Customer reviews of places on Google Maps, with star rating, text and date.","hint":"Find the places with a web search and pass their full Google Maps URLs or Place IDs. Useful for watching what customers say about a business or its competitors. Short maps.app.goo.gl links are not supported.","entity_type":"post","fields":[{"name":"place_urls","description":"Google Maps place or search URLs, URLs containing a Place ID, or bare Place IDs, 1 to 10.","example":"ChIJN1t_tDeuEmsRUsoyG83frY4","kind":"url_list","max_items":10,"max_chars":2000}],"required_any_of":[["place_urls"]]},{"key":"google_play_reviews","platform":"google_play","title":"Google Play reviews","finds":"The newest customer reviews of an Android app on Google Play, with star rating, text, helpful votes and date.","hint":"Pass the app's package name, the text after id= in its Google Play link, such as com.duolingo. Add a two-letter country to read that country's store; the default is the United States. Each run returns up to 50 of the newest reviews.","entity_type":"post","fields":[{"name":"app_id","description":"The app's Google Play package name, such as com.duolingo: the text after id= in its Google Play link.","example":"com.duolingo","kind":"string","max_chars":200},{"name":"country","description":"Two-letter country of the Google Play store to read, such as de. Leave out for the United States.","example":"de","kind":"string","max_chars":2}],"required_any_of":[["app_id"]]},{"key":"hacker_news_hiring","platform":"hackernews","title":"Hacker News hiring posts","finds":"Job posts from the latest Hacker News Who is hiring thread that mention a keyword, with company, location, role text and date.","hint":"Pass a keyword such as rust or designer. Each run reads the latest Who is hiring thread, including remote and on-site posts. To search Hacker News stories instead, use hacker_news_stories.","entity_type":"job","fields":[{"name":"query","description":"A keyword the hiring posts must mention, such as rust.","example":"rust","kind":"string","max_chars":200}],"required_any_of":[["query"]]},{"key":"hacker_news_stories","platform":"hackernews","title":"Hacker News stories","finds":"Hacker News stories matching a search phrase, with title, link, points, comment count and date.","hint":"Pass a search phrase such as rust async. Each run returns up to 20 matching stories. To find job posts from the Who is hiring thread instead, use hacker_news_hiring.","entity_type":"post","fields":[{"name":"query","description":"What to search Hacker News stories for, such as rust async.","example":"rust async","kind":"string","max_chars":200}],"required_any_of":[["query"]]},{"key":"indeed_jobs","platform":"indeed","title":"Indeed jobs","finds":"Recent Indeed job listings for a keyword and location, with title, company, location, pay, job type, posting date and description.","hint":"Give keywords and a location, such as \"receptionist\" and \"Austin, TX\". country is a two-letter code (GB for the United Kingdom; most countries are supported) and defaults to US. posted_within is how many days back to look on the first run (1, 3, 7 or 14; default 14); later daily runs only look at the last day.","entity_type":"job","fields":[{"name":"keywords","description":"Job title, skills or company, such as \"receptionist\". Use together with location.","example":"receptionist","kind":"string","max_chars":100},{"name":"location","description":"City, state, zip code or \"remote\", such as \"Austin, TX\". Use together with keywords.","example":"Austin, TX","kind":"string","max_chars":100},{"name":"country","description":"Two-letter code of the country to search, such as US, CA or AU (most countries are supported; GB for the United Kingdom). Defaults to US.","example":"US","kind":"string","max_chars":20},{"name":"posted_within","description":"On the first run, only jobs posted within this many days: 1, 3, 7 or 14. Defaults to 14. Daily runs always look at the last day.","example":"7","kind":"string","max_chars":20}],"required_any_of":[["keywords","location"]]},{"key":"instagram_profiles","platform":"instagram","title":"Instagram profiles","finds":"Public details of Instagram profiles, with name, bio, link, business category, follower count and post count.","hint":"Pass the usernames (with or without @) or https://www.instagram.com/\u003cusername\u003e/ links of the profiles to look up; find them with a web search such as \"\u003cbusiness\u003e \u003ccity\u003e instagram\". Links to posts, reels or tags are not accepted. Contact details such as email and phone are not included. Each profile is one record; its posts are not included.","entity_type":"person","fields":[{"name":"usernames","description":"Instagram usernames, 1 to 10, with or without the leading @. A profile link is also accepted.","example":"austin.dental","kind":"string_list","max_items":10,"max_chars":200}],"required_any_of":[["usernames"]]},{"key":"linkedin_ads","platform":"linkedin","title":"LinkedIn ads","finds":"Ads running on LinkedIn from one or more companies or matching a keyword, with advertiser, headline, description, landing page and format.","hint":"Pass either advertisers, 1 to 10 company names such as Salesforce, or keyword, a word the ads mention, but not both. Add countries as comma-separated two-letter codes such as US,GB, or ALL. Each run returns the first page of ads per advertiser, and each ad's source column names the advertiser it was collected for.","entity_type":"post","fields":[{"name":"advertisers","description":"Company names whose ads to collect, such as Salesforce, 1 to 10. Use this or keyword.","example":"Salesforce","kind":"string_list","max_items":10,"max_chars":200},{"name":"keyword","description":"A word or phrase the ads mention, such as crm software. Use this or advertisers.","example":"crm software","kind":"string","max_chars":200},{"name":"countries","description":"Only ads shown in these countries: comma-separated two-letter codes such as US,GB, or ALL for every country. Leave out for the default.","example":"US,GB","kind":"string","max_chars":100}],"required_any_of":[["advertisers"],["keyword"]]},{"key":"linkedin_jobs","platform":"linkedin","title":"LinkedIn jobs","finds":"Public LinkedIn job listings for a keyword and location, or from LinkedIn job-search URLs.","hint":"Give keywords and a location, or paste full URLs from a public LinkedIn job search (linkedin.com/jobs/search). Use one or the other, not both.","entity_type":"job","fields":[{"name":"keywords","description":"Job title, skills or free-text search, such as \"nanny\". Use together with location.","example":"nanny","kind":"string","max_chars":200},{"name":"location","description":"City, region or country as you would type it on LinkedIn, such as \"Austin, Texas\". Use together with keywords.","example":"Austin, Texas","kind":"string","max_chars":200},{"name":"search_urls","description":"Public LinkedIn job-search URLs (linkedin.com/jobs/search), 1 to 5, used instead of keywords and location.","example":"https://www.linkedin.com/jobs/search/?keywords=nanny\u0026location=Austin%2C%20Texas","kind":"url_list","max_items":5,"max_chars":2000}],"required_any_of":[["keywords","location"],["search_urls"]]},{"key":"linkedin_posts","platform":"linkedin","title":"LinkedIn posts","finds":"LinkedIn posts that match a search phrase, or recent posts by specific people or companies.","hint":"This searches posts, not profiles. Write queries the way you would type them in LinkedIn search, or pass profile or company URLs to follow specific authors. Given both, only posts by those authors that match the queries are returned.","entity_type":"post","fields":[{"name":"queries","description":"LinkedIn post search phrases, 1 to 5, as typed in LinkedIn search. With author_urls, searches only those authors' posts.","example":"nanny agency","kind":"string_list","max_items":5,"max_chars":200},{"name":"author_urls","description":"LinkedIn profile (/in/...) or company (/company/...) URLs whose posts to collect, 1 to 10.","example":"https://www.linkedin.com/company/example-agency","kind":"url_list","max_items":10,"max_chars":2000}],"required_any_of":[["queries"],["author_urls"]]},{"key":"product_hunt_launches","platform":"producthunt","title":"Product Hunt launches","finds":"Today's product launches on Product Hunt, with name, tagline, summary, category, whether it is free, and website.","hint":"Takes no input. Each run returns up to 20 of today's launches; repeat daily to see each day's new launches.","entity_type":"post","fields":[],"required_any_of":[[]]},{"key":"reddit","platform":"reddit","title":"Reddit posts","finds":"Reddit posts that match search terms (optionally inside one subreddit), or recent posts from subreddit and post URLs.","hint":"Use queries (optionally with subreddit, the name without r/) to search, or urls to read specific subreddits or posts. Do not combine queries and urls.","entity_type":"post","fields":[{"name":"queries","description":"Reddit search terms, 1 to 5. Cannot be combined with urls.","example":"nanny recommendations","kind":"string_list","max_items":5,"max_chars":200},{"name":"subreddit","description":"Limit the searches to one subreddit, given as the name without r/. Requires queries.","example":"Austin","kind":"string","max_chars":21},{"name":"urls","description":"Subreddit or post URLs (reddit.com/r/...), 1 to 10. Cannot be combined with queries.","example":"https://www.reddit.com/r/nanny/","kind":"url_list","max_items":10,"max_chars":2000}],"required_any_of":[["queries"],["urls"]]},{"key":"tiktok","platform":"tiktok","title":"TikTok videos","finds":"TikTok videos by hashtag, profile, search phrase or video URL, with views, likes, comments and shares.","hint":"Pass at least one of hashtags, profiles, queries or video_urls. Hashtags are given without #, and profiles are usernames with or without @.","entity_type":"post","fields":[{"name":"hashtags","description":"TikTok hashtags to follow, 1 to 10, with or without the leading #.","example":"nanny","kind":"string_list","max_items":10,"max_chars":200},{"name":"profiles","description":"TikTok usernames whose videos to collect, 1 to 10, with or without the leading @.","example":"example_creator","kind":"string_list","max_items":10,"max_chars":200},{"name":"queries","description":"TikTok search phrases, 1 to 10.","example":"nanny tips","kind":"string_list","max_items":10,"max_chars":200},{"name":"video_urls","description":"TikTok video URLs (tiktok.com/@user/video/...), 1 to 10.","example":"https://www.tiktok.com/@example_creator/video/7100000000000000001","kind":"url_list","max_items":10,"max_chars":2000}],"required_any_of":[["hashtags"],["profiles"],["queries"],["video_urls"]]},{"key":"trustpilot_reviews","platform":"trustpilot","title":"Trustpilot reviews","finds":"Recent customer reviews of a company on Trustpilot, with star rating, title, text and date.","hint":"Pass the company's website domain, such as notion.so. Use stars to keep only reviews with at least that many stars. Each run returns up to 20 reviews, the most recent first.","entity_type":"post","fields":[{"name":"domain","description":"The company's website domain, such as notion.so. A web address is reduced to its domain.","example":"notion.so","kind":"string","max_chars":253},{"name":"stars","description":"Only reviews with at least this many stars: 1, 2, 3, 4 or 5. Leave out for all reviews.","example":"1","kind":"string","max_chars":20}],"required_any_of":[["domain"]]},{"key":"upwork_jobs","platform":"upwork","title":"Upwork jobs","finds":"Recent Upwork job posts matching search phrases, with title, description, the pay offered, posting date, client country, whether the client's payment is verified and how many proposals the job has.","hint":"Give one to five search phrases, such as \"build AI agent for CRM\"; a job matching any of them is returned. payment_verified: \"yes\" keeps only clients whose payment method is verified. client_history keeps only clients with \"none\" (never hired), \"1-9\" or \"10+\" past hires. The first run looks back two weeks; later daily runs only look at the last day.","entity_type":"job","fields":[{"name":"queries","description":"What to look for, as you would type it into the Upwork job search, such as \"build AI agent for CRM\". 1 to 5; a job matching any of them is returned.","example":"build AI agent for CRM","kind":"string_list","max_items":5,"max_chars":200},{"name":"payment_verified","description":"\"yes\" for only jobs whose client has a verified payment method. Leave out for all jobs.","example":"yes","kind":"string","max_chars":20},{"name":"client_history","description":"Only jobs from clients with this many past hires: none, 1-9 or 10+. Leave out for all clients.","example":"10+","kind":"string","max_chars":20}],"required_any_of":[["queries"]]},{"key":"x_search","platform":"x","title":"X search","finds":"X posts that match a search phrase, newest first.","hint":"Write search phrases the way you would type them in X search.","entity_type":"post","fields":[{"name":"search_terms","description":"X search phrases, 1 to 10, as typed in X search.","example":"YC S26","kind":"string_list","max_items":10,"max_chars":200}],"required_any_of":[["search_terms"]]},{"key":"youtube_videos","platform":"youtube","title":"YouTube videos","finds":"YouTube videos matching a search phrase, with title, channel, description, length and view count.","hint":"Pass a search phrase such as rust programming. Each run returns up to 20 videos.","entity_type":"post","fields":[{"name":"query","description":"What to search YouTube videos for, such as rust programming.","example":"rust programming","kind":"string","max_chars":200}],"required_any_of":[["query"]]}]}
